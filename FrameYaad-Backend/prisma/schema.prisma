generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  EMPLOYEE
  ADMIN

  @@map("user_role")
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED

  @@map("order_status")
}

enum NotificationType {
  ACCOUNT_CREATED
  ORDER_PLACED

  @@map("notification_type")
}

model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String    @db.VarChar(120)
  email                 String    @unique @db.VarChar(320)
  isEmailVerified       Boolean   @default(false) @map("is_email_verified")
  phoneNumber           String?   @unique @map("phone_number") @db.VarChar(20)
  isPhoneNumberVerified Boolean   @default(false) @map("is_phone_number_verified")
  addressLine           String?   @map("address_line") @db.VarChar(255)
  postalCode            String?   @map("postal_code") @db.VarChar(20)
  city                  String?   @db.VarChar(100)
  state                 String?   @db.VarChar(100)
  country               String?   @db.VarChar(100)
  gender                String?   @db.VarChar(30)
  role                  UserRole  @default(CUSTOMER)
  isActive              Boolean   @default(true) @map("is_active")
  createdById           String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy       User?          @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers    User[]         @relation("UserCreatedBy")
  addresses       UserAddress[]
  materials       Material[]     @relation("MaterialCreatedBy")
  variants        Variant[]      @relation("VariantCreatedBy")
  products        Product[]      @relation("ProductCreatedBy")
  cart            Cart?
  orders          Order[]
  wishlistItems   Wishlist[]
  notifications   Notification[] @relation("NotificationRecipient")
  notificationsRead Notification[] @relation("NotificationReadBy")

  @@index([createdById])
  @@index([role, isActive])
  @@map("users")
}

model UserAddress {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String  @map("user_id") @db.Uuid
  addressLine   String  @map("address_line") @db.VarChar(255)
  postalCode    String  @map("postal_code") @db.VarChar(20)
  city          String  @db.VarChar(100)
  state         String  @db.VarChar(100)
  country       String  @db.VarChar(100)
  contactPerson String  @map("contact_person") @db.VarChar(120)
  contactNumber String  @map("contact_number") @db.VarChar(20)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("user_addresses")
}

model Material {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(120)
  description     String?
  brandName       String   @map("brand_name") @db.VarChar(120)
  material        String   @db.VarChar(120)
  availableColors String[] @default([]) @map("available_colors")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById     String?  @map("created_by") @db.Uuid
  createdBy User?     @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  products  Product[]

  @@unique([brandName, name])
  @@index([createdById])
  @@index([isActive])
  @@map("materials")
}

model Variant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  color       String   @db.VarChar(80)
  frameSize   String   @map("frame_size") @db.VarChar(80)
  mountType   String   @map("mount_type") @db.VarChar(80)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdById String?  @map("created_by") @db.Uuid
  mrp         Decimal  @map("mrp") @db.Decimal(12, 2)
  price       Decimal  @db.Decimal(12, 2)
  createdBy User?     @relation("VariantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  products  Product[]

  @@unique([color, frameSize, mountType, mrp, price])
  @@index([createdById])
  @@index([isActive])
  @@map("variants")
}

model Product {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  materialId        String   @map("material_id") @db.Uuid
  variantId         String   @map("variant_id") @db.Uuid
  productIdentifier String   @unique @map("product_identifier") @db.VarChar(100)
  productName       String   @map("product_name") @db.VarChar(160)
  createdById       String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  material  Material       @relation(fields: [materialId], references: [id], onDelete: Restrict)
  variant   Variant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdBy User?          @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  images    ProductImage[]
  cartItems CartItem[]
  orderItems OrderItem[]
  wishlistItems Wishlist[]

  @@index([materialId])
  @@index([variantId])
  @@index([createdById])
  @@index([productName])
  @@map("products")
}

model ProductImage {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productIdentifier String   @map("product_identifier") @db.VarChar(100)
  imageUrl          String   @map("image_url")
  isPrimary         Boolean  @default(false) @map("is_primary")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productIdentifier], references: [productIdentifier], onDelete: Cascade, onUpdate: Cascade)
  @@index([productIdentifier])
  @@map("product_images")
}

model Cart {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @unique @map("user_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  totalPrice Decimal    @default(0) @map("total_price") @db.Decimal(12, 2)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId            String  @map("cart_id") @db.Uuid
  productIdentifier String  @map("product_identifier") @db.VarChar(100)
  quantity          Int
  subtotal          Decimal @db.Decimal(12, 2)
  price             Decimal @db.Decimal(12, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productIdentifier], references: [productIdentifier], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cartId, productIdentifier])
  @@index([productIdentifier])
  @@map("cart_items")
}

model Order {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  orderNumber   String      @unique @map("order_number") @db.VarChar(40)
  totalPrice    Decimal     @map("total_price") @db.Decimal(12, 2)
  status        OrderStatus @default(PLACED) @map("order_status")
  userAddressId String      @map("user_address_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  remark        String?
  couponId      String?     @map("coupon_id") @db.Uuid

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  userAddress UserAddress  @relation(fields: [userAddressId], references: [id], onDelete: Restrict)
  items       OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userAddressId])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String  @map("order_id") @db.Uuid
  productIdentifier String  @map("product_identifier") @db.VarChar(100)
  quantity          Int
  subtotal          Decimal @db.Decimal(12, 2)
  price             Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productIdentifier], references: [productIdentifier], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([productIdentifier])
  @@map("order_items")
}

model Wishlist {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  productIdentifier String   @map("product_identifier") @db.VarChar(100)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productIdentifier], references: [productIdentifier], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, productIdentifier])
  @@index([productIdentifier])
  @@map("wishlists")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?          @map("user_id") @db.Uuid
  title     String           @db.VarChar(160)
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  readById  String?          @map("read_by") @db.Uuid
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User? @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  readBy User? @relation("NotificationReadBy", fields: [readById], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
  @@index([type, createdAt])
  @@index([readById])
  @@map("notifications")
}
